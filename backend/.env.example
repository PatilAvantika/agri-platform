# Agri Platform Backend Environment Configuration

# ======================================
# DATABASE CONFIGURATION
# ======================================
DATABASE_URL=postgresql://user:password@localhost:5432/agri_platform
# For SQLite development (alternative):
# DATABASE_URL=sqlite:///./agri_platform.db

# ======================================
# WEATHER API CONFIGURATION
# ======================================
WEATHER_API_KEY=your_openweather_api_key_here
# Get your free API key from: https://openweathermap.org/api

# ======================================
# AI/LLM SERVICE CONFIGURATION
# ======================================
GROQ_API_KEY=your_groq_api_key_here
# Get your API key from: https://console.groq.com/

# ======================================
# AUTHENTICATION & SECURITY
# ======================================
SECRET_KEY=your_super_secret_jwt_key_here_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ======================================
# BLOCKCHAIN CONFIGURATION (Optional)
# ======================================
PROVIDER_URL=https://eth-mainnet.g.alchemy.com/v2/your_api_key
ADMIN_PRIVATE_KEY=your_admin_private_key_for_blockchain_operations

# ======================================
# EXTERNAL SERVICES
# ======================================
# SMS Gateway (for OTP)
SMS_API_KEY=your_sms_gateway_api_key
SMS_SENDER_ID=AGRIAPP

# Email Service (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ======================================
# DEVELOPMENT SETTINGS
# ======================================
DEBUG=True
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ======================================
# CORS SETTINGS
# ======================================
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080", "https://your-frontend-domain.com"]

# ======================================
# RATE LIMITING
# ======================================
RATE_LIMIT_PER_MINUTE=60

# ======================================
# CACHE SETTINGS
# ======================================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600  # 1 hour in seconds

# ======================================
# FILE UPLOAD SETTINGS
# ======================================
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_PATH=./uploads

# ======================================
# PRODUCTION OVERRIDES
# ======================================
# Set these in production:
# DEBUG=False
# LOG_LEVEL=WARNING
# DATABASE_URL=your_production_database_url
# SECRET_KEY=your_production_secret_key
